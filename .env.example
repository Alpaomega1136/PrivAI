# Optional overrides for docker-compose. Copy to ".env" and edit as needed.
# docker compose automatically reads ".env" from this folder.

# Host ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

# "cpu" or "cuda" (cuda needs the NVIDIA container runtime — not configured here)
MODEL_DEVICE=cpu

# Demo auth tokens — CHANGE THESE for any real deployment.
GOVERNMENT_TOKEN=privai-government-demo-token
APPROVER_TOKEN=privai-approver-demo-token
CRYPTO_ADMIN_TOKEN=privai-crypto-admin-demo-token

# Allowed CORS origins for the backend (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
